{
  "name": "@viviengraffin/translation-core",
  "version": "2.1.0",
  "license": "MIT",
  "tasks": {
    "test": "deno test --allow-env"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@^1.0.19",
    "@/": "./src/"
  },
  "exports": {
    ".": "./src/main.ts",
    "./backend": "./src/environments/backend/main.ts",
    "./frontend": "./src/environments/frontend/main.ts",
    "./string": "./src/string/main.ts"
  },
  "lint": {
    "rules": {
      "exclude": [
        "no-explicit-any",
        "ban-ts-comment"
      ]
    }
  },
  "publish": {
    "include": [
      "src/",
      "deno.json",
      "LICENSE",
      "README.md"
    ]
  },
  "fmt": {
    "exclude": [
      "README.md"
    ]
  }
}
